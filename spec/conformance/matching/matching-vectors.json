{
  "title": "PCL Conformance Test Vectors: Capability Matching",
  "version": "0.1.0",
  "vectors": [
    {
      "id": "match-01-success",
      "description": "Exact goal match with satisfied constraints and available state",
      "intent": {
        "pcl_version": "0.1.0",
        "id": "intent-pkg-1",
        "goal": { "vocabulary": "https://pcl.dev/vocab/logistics/v0", "term": "package_transport" },
        "inputs": { "target": { "ref": "pkg-100" } },
        "constraints": { "payload": { "value": 10, "unit": "kg", "comparator": "lte" } }
      },
      "declaration": {
        "pcl_version": "0.1.0",
        "id": "cap-transport-robot17",
        "entity_id": "robot-17",
        "semantic_type": { "vocabulary": "https://pcl.dev/vocab/logistics/v0", "term": "package_transport" },
        "inputs": [{ "name": "target", "role": "object", "value_kind": "entity_ref", "required": true }],
        "constraints": [{ "name": "payload", "quantity": { "value": 25, "unit": "kg", "comparator": "lte" } }],
        "execution": { "protocol": "ros2", "target": "/amr/transport" }
      },
      "offer": {
        "id": "offer-robot17",
        "declaration_id": "cap-transport-robot17",
        "entity_id": "robot-17",
        "state": { "status": "idle" },
        "availability": { "accepts_work": true }
      },
      "expected_match": true,
      "expected_score": 100.5,
      "expected_satisfied": ["goal", "inputs", "constraints", "state", "availability"]
    },
    {
      "id": "match-02-goal-mismatch",
