        "inputs": [],
        "execution": { "protocol": "http", "target": "https://api.example.com" }
      },
      "offer": {
        "id": "offer-robot17",
        "declaration_id": "cap-transport-robot17",
        "entity_id": "robot-17",
        "state": { "status": "idle" },
        "availability": { "accepts_work": true }
      },
