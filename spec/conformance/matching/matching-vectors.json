      },
      "declaration": {
        "pcl_version": "0.1.0",
        "id": "cap-light",
        "entity_id": "drone-1",
        "semantic_type": { "vocabulary": "https://pcl.dev/vocab/logistics/v0", "term": "package_transport" },
        "inputs": [],
