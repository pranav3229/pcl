{
  "title": "PCL Conformance Test Vectors: ExecutionBinding Parameter Resolution",
  "version": "0.1.0",
  "vectors": [
    {
      "id": "param-01-nested-ros2-goal",
      "description": "Resolve flat inputs and object references into nested ROS 2 action goal structure",
      "parameters_map": {
        "goal.package_id": "inputs.package.ref",
        "goal.destination": "inputs.destination.ref"
      },
      "intent_context": {
        "inputs": {
          "package": { "ref": "pkg-999" },
          "destination": { "ref": "bay-12" }
        },
        "constraints": {}
      },
      "expected_native_payload": {
        "goal": {
          "package_id": "pkg-999",
          "destination": "bay-12"
        }
      }
    },
    {
      "id": "param-02-coordinates-resolution",
      "description": "Resolve location coordinate fields into target pose dictionary",
      "parameters_map": {
        "target.lat": "inputs.site.lat",
        "target.lon": "inputs.site.lon",
        "target.alt": "inputs.site.alt"
      },
      "intent_context": {
        "inputs": {
          "site": {
            "value": { "lat": 12.9716, "lon": 77.5946, "alt": 920.0 }
          }
        },
        "constraints": {}
      },
      "expected_native_payload": {
        "target": {
          "lat": 12.9716,
          "lon": 77.5946,
          "alt": 920.0
        }
      }
    },
    {
      "id": "param-03-constraint-value-resolution",
      "description": "Resolve constraint limits into native parameter values",
      "parameters_map": {
        "feed_rate": "inputs.speed",
        "max_tol": "constraints.tolerance.value"
      },
      "intent_context": {
        "inputs": {
          "speed": { "value": 250 }
        },
        "constraints": {
          "tolerance": { "value": 0.02, "unit": "mm", "comparator": "lte" }
        }
      },
      "expected_native_payload": {
        "feed_rate": 250,
        "max_tol": 0.02
      }
    }
  ]
}
